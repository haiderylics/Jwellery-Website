# ==============================================================================
# Jewellery E-Commerce - Environment Configuration Template (.env.example)
#
# Copy this file to .env for local development overrides:
#   cp .env.example .env
#
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Set to 'backend.config.settings.development' or 'backend.config.settings.production'
DJANGO_SETTINGS_MODULE=backend.config.settings.development

# In production, DJANGO_SECRET_KEY is MANDATORY and must be a cryptographically
# secure random string (minimum 50 characters).
# Leave unset in development to use the safe development-only fallback.
# DJANGO_SECRET_KEY=generate-a-strong-secret-key-for-production-use-min-50-chars

# Debug mode: True for development only. MUST BE False in production.
DJANGO_DEBUG=True

# Comma-separated list of valid host/domain names for this site.
# Example: localhost,127.0.0.1,api.example.com,www.zirconiajewels.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF protection on unsafe requests.
# Example: http://localhost:5173,https://www.zirconiajewels.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of allowed origins for public CORS access.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# In development, SQLite is used by default if DATABASE_URL is not set.
# In production, PostgreSQL is mandatory.
# Example: postgresql://jewellery_user:secure_password@localhost:5432/jewellery_prod
# DATABASE_URL=postgresql://jewellery_user:secure_password@localhost:5432/jewellery_prod

# ------------------------------------------------------------------------------
# Reverse Proxy & Upload Boundaries
# ------------------------------------------------------------------------------
# Application Validators: max 10 MB per image, max 50 MB per video.
# Reverse Proxy (e.g. Nginx / Caddy / Traefik) MUST configure matching request caps:
#   Nginx: client_max_body_size 60M;
# Django In-Memory Upload Buffer: 5 MB (FILE_UPLOAD_MAX_MEMORY_SIZE)

# ------------------------------------------------------------------------------
# Production Cache (single-replica MVP)
# ------------------------------------------------------------------------------
# Development uses in-process LocMemCache.
# Production uses bounded, ephemeral FileBasedCache. Railway defaults to the path
# below, so this variable is optional. It must be absolute and outside MEDIA_ROOT
# and STATIC_ROOT. Do not attach a Volume or store business/customer data here.
# DJANGO_CACHE_LOCATION=/tmp/ahs-jewellers-cache
# Before horizontally scaling to multiple service replicas, replace this cache
# with shared Redis/Memcached because container filesystems are not shared.

# ------------------------------------------------------------------------------
# Static & Media Storage
# ------------------------------------------------------------------------------
# DJANGO_STATIC_ROOT=/var/www/jewellery/staticfiles
# DJANGO_MEDIA_ROOT=/var/www/jewellery/media

# Cloudinary is the production media store. Add these only to Railway, never Netlify.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
